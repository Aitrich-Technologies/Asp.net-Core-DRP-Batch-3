@model MVC_Workshop01.Dto.TourBookingDto

@{
    ViewData["Title"] = "Delete Booking";
    Layout = "~/Views/Shared/_TourLayout.cshtml";
}

<div class="container mt-5">

    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <h3>Delete Booking</h3>
        </div>

        <div class="card-body">

            <h5>Are you sure you want to delete this booking?</h5>

            <hr />

            <dl class="row">
                <dt class="col-sm-4">First Name</dt>
                <dd class="col-sm-8">@Model.FirstName</dd>

                <dt class="col-sm-4">Last Name</dt>
                <dd class="col-sm-8">@Model.LastName</dd>

                <dt class="col-sm-4">Gender</dt>
                <dd class="col-sm-8">@Model.Gender</dd>

                <dt class="col-sm-4">Citizenship</dt>
                <dd class="col-sm-8">@Model.Citizenship</dd>

                <dt class="col-sm-4">Passport Number</dt>
                <dd class="col-sm-8">@Model.PassportNumber</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@Model.Status</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>

        </div>
    </div>

</div>
