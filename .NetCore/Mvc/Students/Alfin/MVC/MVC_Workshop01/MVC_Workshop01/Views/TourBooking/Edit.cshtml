@model MVC_Workshop01.Dto.TourBookingDto

@{
    ViewData["Title"] = "Edit Booking";
    Layout = "~/Views/Shared/_TourLayout.cshtml";
}

<div class="container mt-4">

    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <h3>Edit Booking</h3>
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="UserId" />

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Gender" class="form-label"></label>
                        <input asp-for="Gender" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Dob" class="form-label"></label>
                        <input asp-for="Dob" type="date" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Citizenship" class="form-label"></label>
                        <input asp-for="Citizenship" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="PassportNumber" class="form-label"></label>
                        <input asp-for="PassportNumber" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="IssueDate" class="form-label"></label>
                        <input asp-for="IssueDate" type="date" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ExpiryDate" class="form-label"></label>
                        <input asp-for="ExpiryDate" type="date" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="PlaceOfBirth" class="form-label"></label>
                        <input asp-for="PlaceOfBirth" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ParticipantType" class="form-label"></label>
                        <input asp-for="ParticipantType" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <input asp-for="Status" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-check mt-4">
                            <input asp-for="LeadPassenger" class="form-check-input" />
                            <label asp-for="LeadPassenger" class="form-check-label">
                                Lead Passenger
                            </label>
                        </div>
                    </div>

                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-warning">
                        Update Booking
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>
