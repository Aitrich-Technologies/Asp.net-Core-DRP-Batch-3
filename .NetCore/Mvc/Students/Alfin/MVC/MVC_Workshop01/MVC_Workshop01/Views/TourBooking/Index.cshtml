@model IEnumerable<MVC_Workshop01.Dto.TourBookingDto>

@{
    ViewData["Title"] = "Tours & Packages";
    Layout = "~/Views/Shared/_TourLayout.cshtml";
}
<div class="container mt-5">
   
    <div class="d-flex justify-content-end  mb-4">
        <a asp-controller="TourBooking"
                               asp-action="Create"
                               asp-route-id="@Model"
                               class="btn btn-primary rounded-pill px-3">
                            Book Now
                        </a>
                     
       
    </div>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">My Bookings</h2>
            <span class="badge bg-info text-dark mt-2">
                @Model.Count() Bookings Found
            </span>
        </div>

       
    </div>


    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color:#cfd8e6;">
                    <tr>
                        <th>#</th>
                        <th>First Name</th>
                        <th>Last name</th>
                        
                        <th>Status</th>
                   
                    </tr>
                </thead>

                <tbody>
                    @{
                        int count = 1;
                    }
                      
                        @foreach (var item in Model)
                        {
                        <tr>

                            <td>@count</td> 
                            <td class="fw-semibold">@item.FirstName</td>
                            <td style="max-width:300px;">
                                @item.LastName
                            </td>
                          
                            <td>
                                <span class="badge bg-secondary">
                                    @item.Status
                                </span>
                            </td>

                            <td>
                                
                                <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm">
                                    <i class="bi bi-eye"></i> Details
                                </a>

                                <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                           
                             </tr>  
                       

                        count++;
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>