@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model MVC_MechineText11.Dto.TourPackageDto

<h2>Tour Package Details</h2>

<hr />

<dl class="row">

    <dt class="col-sm-3">Package Name</dt>
    <dd class="col-sm-9">@Model.PackageName</dd>

    <dt class="col-sm-3">Destination</dt>
    <dd class="col-sm-9">@Model.Destination</dd>

    <dt class="col-sm-3">Price</dt>
    <dd class="col-sm-9">@Model.Price</dd>

    <dt class="col-sm-3">Duration</dt>
    <dd class="col-sm-9">@Model.Duration</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

</dl>

<div class="mt-3">

    

    <a asp-action="Index" class="btn btn-secondary">
        Back
    </a>

</div>

