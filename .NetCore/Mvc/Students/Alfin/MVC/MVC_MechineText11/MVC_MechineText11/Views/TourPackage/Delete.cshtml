@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model MVC_MechineText11.Dto.TourPackageDto

<h2>Delete Tour Package</h2>

<h4>Are you sure?</h4>

<hr />

<dl class="row">

    <dt class="col-sm-3">Package Name</dt>
    <dd class="col-sm-9">@Model.PackageName</dd>

    <dt class="col-sm-3">Destination</dt>
    <dd class="col-sm-9">@Model.Destination</dd>

    <dt class="col-sm-3">Price</dt>
    <dd class="col-sm-9">@Model.Price</dd>

    <dt class="col-sm-3">Duration</dt>
    <dd class="col-sm-9">@Model.Duration</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

</dl>


<form asp-action="Delete" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>

