@model Login_Sample.Dto.RegisterDto
@{
    ViewData["Title"] = "Register";
}
<div class="col-md p-5 ">
    <h3 class="fw-bold text-center mb-4 text-primary">Create Your Account</h3>
    <div asp-validation-summary="All" class="taxt-danger"></div>
    <form asp-action="Register" method="post">
        <div class="">
            <div class="col-md mb-3">
                <label class="form-label">First Name</label>
                <input asp-for="UserName" class="form-control" placeholder="John" required />
            </div>
        <div class="">
            <div class="col-md mb-3">
                <label class="form-label">Phone Number</label>
                <input asp-for="TelephoneNo" type="text" class="form-control" placeholder="+1 (555) 123-4567" />
            </div>
           
        </div>

        <div class="">
                <div class="col-md mb-3">
                    <label class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Create a strong password" required />
                    <small class="text-muted">Must be at least 8 characters long</small>
                </div>
        </div>
        
        <button type="submit" class="btn btn-primary w-100 rounded-pill">Sign Up</button>

        <div class="text-center mt-3">
            <p class="text-muted mb-0">
                Already have an account?
                <a asp-action="Login" class="fw-semibold text-primary">Sign In</a>
            </p>
        </div>
    </form>
</div>