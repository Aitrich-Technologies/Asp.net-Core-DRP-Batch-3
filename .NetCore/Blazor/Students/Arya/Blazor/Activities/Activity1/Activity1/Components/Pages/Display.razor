@page "/Display"
@using Activity1.Data
@inject EmployeeService EmpService
@rendermode InteractiveServer

<style>
    .card {
        background-color: lightsteelblue;
        border-radius: 25px;
        margin: 5%;
        padding: 3%;
        color: #fff;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-6">

            @if (EmployeeList.Count > 0)
            {
                @foreach (EmployeeDetails emp in EmployeeList)
                {
                    <div class="card">
                        <h6>@emp.FirstName @emp.LastName</h6>
                        <p>@emp.Email</p>
                        <p>@emp.Phone</p>

                        <div class="row">
                            <div class="col-md-6">
                                <a class="btn btn-primary me-2"
                                   href="/Edit/@emp.Id">
                                    Edit
                                </a>

                                <a class="btn btn-danger"
                                   href="/Delete/@emp.Id">
                                    Delete
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p>No Employees Found.</p>
            }

        </div>
    </div>
</div>

@code {
    List<EmployeeDetails> EmployeeList = new();

    protected override void OnInitialized()
    {
        EmployeeList = EmpService.GetEmployeeDetails();
    }
}