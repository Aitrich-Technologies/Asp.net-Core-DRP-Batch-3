@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IDestinationService DestinationService

@using BlazorWorkshop2.Dto
@using BlazorWorkshop2.Interface
@using BlazorWorkshop2.Service
@using Microsoft.EntityFrameworkCore.Metadata.Internal


<h3>Index</h3>

<div class="container mt-4">

    
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold">Destinations & Packages</h3>
            <span class="badge bg-success">
                @(destinations?.Count ?? 0) Destinations Found
            </span>
        </div>

       

    </div>

    @if (destinations == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (!destinations.Any())
    {
        <div class="alert alert-info text-center">
            No Destinations Available.
        </div>
    }
    else
    {
      
        <div class="row">
            @foreach (var item in destinations)
            {
                <div class="col-md-3 mb-4">
                    <div class="card shadow-sm h-100">

                        <img src="@item.ImageUrl"
                             class="card-img-top"
                             style="height:200px; object-fit:cover;" />

                        <div class="card-body">
                            <h5 class="fw-bold">@item.Name</h5>

                            <p class="text-muted">
                                @item.Description
                            </p>

                            <div class="d-flex justify-content-between">
                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="() => EditDestination(item.Id)">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>


                                <button class="btn btn-outline-danger btn-sm"
                                        @onclick="() => DeleteDestination(item.Id)">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>



@code {
    private List<DestinationDto> destinations;

    protected override async Task OnInitializedAsync()
    {
        destinations = await DestinationService.GetAllAsync();
    }
    private void EditDestination(int id)
    {
        Navigation.NavigateTo($"edit/{id}");
    }

    private async Task DeleteDestination(int id)
    {
        await DestinationService.DeleteAsync(id);
        destinations = await DestinationService.GetAllAsync();
    }
}
