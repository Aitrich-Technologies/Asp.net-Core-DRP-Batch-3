@page "/register"
@rendermode InteractiveServer
@using Blazor_Workshop.Dto;
@using Blazor_Workshop.Interface;
@inject IAuthService AuthService
@inject NavigationManager Navigation
<h3>Register</h3>

<div>
    <EditForm Model="registerDto" OnValidSubmit="Registerr" FormName="Registerform">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger mb-3" />
        <div class="form-floating mb-3">
            <InputText class="form-control" @bind-Value="registerDto.Name" placeholder="Name" />
            <label>Full Name</label>
        </div>

        <div class="form-floating mb-3">
            <InputText class="form-control" @bind-Value="registerDto.Email" placeholder="Email" />
            <label>Email address</label>
        </div>

        <div class="form-floating mb-3">
            <InputText type="password" class="form-control" @bind-Value="password" placeholder="Password" />
            <label>Password</label>
        </div>

        <button type="submit" class="btn btn-success w-100 rounded-pill py-2">
            Register
        </button>
    </EditForm>
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-danger mt-3 text-center">@message</div>
    }

    <div class="text-center mt-3">
        <small>
            Already have an account?
            <a href="/login" class="fw-bold text-decoration-none">Login</a>
        </small>
    </div>
</div>

@code {

    RegisterDto registerDto = new();
    public string password = "";
    public string message = "";

    public async Task Registerr()
    {
        Console.WriteLine($"Name = {registerDto.Name}");
        Console.WriteLine($"Email = {registerDto.Email}");
        Console.WriteLine($"Password = {password}");
        var success = await AuthService.Register(registerDto,password);
        if (success)
        {
            Navigation.NavigateTo("/login");
        }
        else
        {
            message = "Email already exists.";
        }
    }

}
