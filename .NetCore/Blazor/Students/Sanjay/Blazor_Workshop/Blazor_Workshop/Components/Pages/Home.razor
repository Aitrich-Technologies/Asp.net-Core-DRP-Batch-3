@page "/home"
@rendermode InteractiveServer

@using Blazor_Workshop.Models;
@using System.ComponentModel.DataAnnotations
@inject Blazor_Workshop.Interface.ITourService TourService
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment


<h3 class="mb-3">Add Tour</h3>
<p class="text-muted">Create a memorable travel experience</p>

<div class="card shadow p-4">

    <EditForm Model="tour" OnValidSubmit="CreateTour">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- Toggle -->
        <div class="d-flex justify-content-between align-items-center mb-4 border rounded p-3">
            <div>
                <strong>Customized Tour</strong>
                <div class="text-muted small">
                    Create a personalized tour for a specific customer
                </div>
            </div>

            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" @bind="IsCustomized" />
            </div>
        </div>

        <!-- Title -->
        <div class="mb-3">
            <label class="form-label">Tour Title *</label>
            <input class="form-control" @bind="tour.Title" />
            <ValidationMessage For="@(() => tour.Title)" />
        </div>

        <!-- Description -->
        <div class="mb-3">
            <label class="form-label">Description *</label>
            <textarea class="form-control" @bind="tour.Description"></textarea>
            <ValidationMessage For="@(() => tour.Description)" />
        </div>

        <!-- Destination + Nights -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label>Destination *</label>
                <select class="form-select" @bind="tour.Destination">
                    <option value="">Select destination</option>
                    <option>Kerala</option>
                    <option>Dubai</option>
                    <option>Bali</option>
                    <option>Singapore</option>
                </select>
                <ValidationMessage For="@(() => tour.Destination)" />
            </div>

            <div class="col-md-6">
                <label>Number of Nights *</label>
                <input type="number" class="form-control" @bind="tour.Nights" />
                <ValidationMessage For="@(() => tour.Nights)" />
            </div>
        </div>

        <!-- Price + Departure -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label>Price *</label>
                <input type="number" class="form-control" @bind="tour.Price" />
                <ValidationMessage For="@(() => tour.Price)" />
            </div>

            <div class="col-md-6">
                <label>Departure Date *</label>
                <input type="date" class="form-control" @bind="tour.DepartureDate" />
                <ValidationMessage For="@(() => tour.DepartureDate)" />
            </div>
        </div>

        <!-- Image Upload -->
        <div class="mb-4">
            <label class="form-label fw-semibold">Upload Image</label>
            <InputFile class="form-control rounded-3"
                       OnChange="UploadImage" />
        </div>

        <!-- Arrival -->
        <div class="mb-4">
            <label>Arrival Date</label>
            <input type="date" class="form-control"
                   @bind="tour.ArrivalDate"
                   min="@tour.DepartureDate.ToString("yyyy-MM-dd")" />
        </div>

        <!-- Buttons -->
        <div class="d-flex justify-content-end">
            <button type="button" class="btn btn-secondary me-2" @onclick="Cancel">Cancel</button>
            <button type="submit" class="btn btn-primary">Create Tour</button>
        </div>

    </EditForm>

</div>

@code {
    private bool IsCustomized { get; set; }
    private IBrowserFile? uploadedFile;

    private Tour tour = new Tour
    {
        Nights = 1
    };

    private async Task UploadImage(InputFileChangeEventArgs e)
    {
        uploadedFile = e.File;
    }

    private async Task CreateTour()
    {
        if (uploadedFile != null)
        {
            var fileName = Guid.NewGuid().ToString()
                           + Path.GetExtension(uploadedFile.Name);

            var folderPath = Path.Combine(Environment.WebRootPath, "images");

            Directory.CreateDirectory(folderPath);

            var filePath = Path.Combine(folderPath, fileName);

            using var stream = new FileStream(filePath, FileMode.Create);
            await uploadedFile.OpenReadStream(10 * 1024 * 1024)
                              .CopyToAsync(stream);

            tour.Image = "/images/" + fileName;
        }
        await TourService.CreateTourAsync(tour);

        Console.WriteLine("Saved to DB!");

        Navigation.NavigateTo("/tourview");

        // Reset form
        tour = new Tour { Nights = 1 };
        IsCustomized = false;
    }

    private void Cancel()
    {
        tour = new Tour { Nights = 1 };
        IsCustomized = false;
    }
}