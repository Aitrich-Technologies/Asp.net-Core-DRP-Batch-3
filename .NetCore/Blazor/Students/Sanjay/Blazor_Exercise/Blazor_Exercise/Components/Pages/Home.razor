@page "/"
@inject NavigationManager Navigation

<div class="hero-banner d-flex align-items-center justify-content-center text-center">
    <div class="hero-content text-white">
        <h1 class="display-3 fw-bold">Explore The World</h1>
        <p class="lead mt-3 mb-4">
            Discover amazing destinations and unforgettable experiences ✈️
        </p>

    </div>
</div>


<div class="container mt-5">
    <h2 class="text-center mb-4">Popular Destinations</h2>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <img src="/Images/img10.jpg" height="350px" />

                <div class="card-body">
                    <h5 class="card-title">Malaysia</h5>
                    <p class="card-text">
                        Experience vibrant culture and stunning islands.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <img src="/Images/img9.jpg" height="350px" />

                <div class="card-body">
                    <h5 class="card-title">Paris</h5>
                    <p class="card-text">
                        The city of love and iconic landmarks.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <img src="/Images/img7.jpg" height="350px" />

                <div class="card-body">
                    <h5 class="card-title">Maldives</h5>
                    <p class="card-text">
                        Relax in luxury over crystal clear waters.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hero-banner {
        height: 90vh;
        background: url('/Images/img5.jpg') no-repeat center center;
        background-size: cover;
        position: relative;
    }

        .hero-banner::before {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,.5);
        }

    .hero-content {
        position: relative;
        z-index: 1;
    }

    .card {
        border-radius: 15px;
        overflow: hidden;
        transition: .3s;
    }

        .card:hover {
            transform: translateY(-8px);
        }
