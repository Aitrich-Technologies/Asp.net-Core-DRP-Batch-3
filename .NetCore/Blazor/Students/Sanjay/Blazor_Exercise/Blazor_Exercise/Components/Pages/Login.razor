@page "/login"
@rendermode InteractiveServer
@using Blazor_Exercise.Dto
@using Blazor_Exercise.Interface
@inject NavigationManager NavigationManager
@inject IUserService UserService



<div class="auth-bg">
    <div class="auth-card">

        <h2 class="text-center mb-4 text-primary fw-bold">Welcome Back</h2>

        <EditForm Model="loginDto" OnValidSubmit="Loginn">
            <DataAnnotationsValidator />

            <div class="form-floating mb-3">
                <InputText class="form-control" autocomplete="off" @bind-Value="loginDto.Email" placeholder="Email" />
                <label>Email address</label>
            </div>

            <div class="form-floating mb-3">
                <InputText type="password" autocomplete="off" class="form-control" @bind-Value="loginDto.Password" placeholder="Password" />
                <label>Password</label>
            </div>

            <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">
                Login
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-danger mt-3 text-center">@message</div>
        }

        <div class="text-center mt-3">
            <small>
                Don’t have an account?
                <a href="/register" class="fw-bold text-decoration-none">Register</a>
            </small>
        </div>

    </div>
</div>



@code {
    LoginDto loginDto = new();
    public string message = "";

    public async Task Loginn()
    {
        var success = await UserService.Login(loginDto);
        if (success)
            NavigationManager.NavigateTo("/DisplayDestination");
        else
            message = "Invalid Creditionals";

    }
}
