@page "/Register"
@rendermode InteractiveServer
@using Blazor_Exercise.Interface
@using Blazor_Exercise.Dto
@inject NavigationManager NavigationManager
@inject IUserService UserService


<div class="auth-bg">
    <div class="auth-card">

        <h2 class="text-center mb-4 text-success fw-bold">Create Account</h2>

        <EditForm Model="registerDto" OnValidSubmit="Registerr">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" />

            <div class="form-floating mb-3">
                <InputText class="form-control" autocomplete="off" @bind-Value="registerDto.Name" placeholder="Name" />
                <label>Full Name</label>
            </div>

            <div class="form-floating mb-3">
                <InputText class="form-control" autocomplete="off" @bind-Value="registerDto.Email" placeholder="Email" />
                <label>Email address</label>
            </div>

            <div class="form-floating mb-3">
                <InputText type="password" class="form-control" @bind-Value="registerDto.Password" placeholder="Password" />
                <label>Password</label>
            </div>

            <button type="submit" class="btn btn-success w-100 rounded-pill py-2">
                Register
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-danger mt-3 text-center">@message</div>
        }

        <div class="text-center mt-3">
            <small>
                Already have an account?
                <a href="/login" class="fw-bold text-decoration-none">Login</a>
            </small>
        </div>

    </div>
</div>



@code {
    RegisterDto registerDto = new();
    public string message = "";

    public async Task Registerr()
    {
        var success = await UserService.Register(registerDto);
        if(success)
        {
            NavigationManager.NavigateTo("/login");
        }
        else
        {
            message = "Email already exists.";
        }
    }
}
