@page
@model Activity1.Pages.TourpackageModel
@{
}
<partial name="_Message"
         model="new Activity1.Pages._MessageModel()" />

<form method="post">
    <label asp-for="PackageId"></label>
    <input asp-for="PackageId" class="form-control"/><br /><br />

    <label asp-for="PackageName"></label>
    <input asp-for="PackageName" class="form-control"/><br /><br />

    <label asp-for="Destination"></label>
    <input asp-validation-for="Destination" class="form-control"/><br /><br />

    <label asp-for="Price"></label>
    <input asp-for="Price" class="form-control"/><br /><br />

    <label asp-for="Duration"></label>
    <input asp-for="Duration" class="form-control"/><br /><br />

    <button type="submit" class="btn btn-primary">Save</button>
</form>



