@page
@model MachineTest.Pages.Package.DeleteModel
@{
}
<div>
    <h4>Package Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Package Title</dt>
        <dd class="col-sm-10">@Model.package.PackageName</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.package.Description</dd>

        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Model.package.Price</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="package.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>