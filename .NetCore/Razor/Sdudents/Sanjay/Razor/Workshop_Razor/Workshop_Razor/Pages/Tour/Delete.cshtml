@page
@model Workshop_Razor.Pages.Tour.DeleteModel
@{
}
<h2>Delete Tour</h2>

<h3>Are you sure you want to delete this Tour?</h3>

<div>
    <h4>Job Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Job Title</dt>
        <dd class="col-sm-10">@Model.TourPost.TourName</dd>

        <dt class="col-sm-2">Company</dt>
        <dd class="col-sm-10">@Model.TourPost.Destination</dd>

        <dt class="col-sm-2">Location</dt>
        <dd class="col-sm-10">@Model.TourPost.Price</dd>

        @* <dt class="col-sm-2">Employment Type</dt>
        <dd class="col-sm-10">@Model.TourPost.EmploymentType</dd>

        <dt class="col-sm-2">Salary Range</dt>
        <dd class="col-sm-10">@Model.TourPost.SalaryRange</dd> *@
    </dl>

    <form method="post">
        <input type="hidden" asp-for="TourPost.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>