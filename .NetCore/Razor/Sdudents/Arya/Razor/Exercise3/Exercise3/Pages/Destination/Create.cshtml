@page
@model Exercise3.Pages.Destination.CreateModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">

    <h2 class="text-center mb-4">➕ Add Destination</h2>

    <form method="post" enctype="multipart/form-data" class="w-50 mx-auto p-4 shadow border rounded">

        <!-- NAME -->
        <div class="mb-3">
            <label class="form-label">Name</label>
            <input asp-for="Destination.Name" class="form-control" placeholder="e.g. Paris" />
        </div>

        <!-- LOCATION -->
        <div class="mb-3">
            <label class="form-label">Location</label>
            <input asp-for="Destination.Location" class="form-control" placeholder=" France" />
        </div>

        <!-- PRICE -->
        <div class="mb-3">
            <label class="form-label">Price</label>
            <input asp-for="Destination.Price" class="form-control" placeholder="e 2000" />
        </div>

        <!-- DURATION -->
        <div class="mb-3">
            <label class="form-label">Duration (Days)</label>
            <input asp-for="Destination.Duration" class="form-control" placeholder="e.g. 5" />
        </div>

        <!-- DESCRIPTION -->
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Destination.Description" class="form-control" rows="3"
                      placeholder="Write about the destination"></textarea>
        </div>

        <!-- IMAGE UPLOAD -->
        <div class="mb-3">
            <label class="form-label">Upload Image</label>
            <input type="file" asp-for="ImageFile" class="form-control" />
        </div>

        <!-- BUTTON -->
        <button type="submit" class="btn btn-primary w-100">
            Save Destination
        </button>

    </form>

</div>