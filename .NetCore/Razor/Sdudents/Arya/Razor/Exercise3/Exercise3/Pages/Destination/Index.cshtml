@page
@model Exercise3.Pages.Destination.IndexModel
<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Destinations</h2>

        <a href="/Destination/Create" class="btn btn-primary">
            Add Destination
        </a>
    </div>

    <div class="row">

        @foreach (var item in Model.Destinations)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">

                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="/images/destinations/@item.ImagePath"
                             class="card-img-top"
                             style="height:200px;object-fit:cover;"
                             alt="@item.Name" />
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/400x200?text=No+Image"
                             class="card-img-top"
                             style="height:200px;object-fit:cover;" />
                    }

                    <div class="card-body">
                        <h5>@item.Name</h5>
                        <p>@item.Description</p>

                        <p>
                            <strong>Location:</strong> @item.Location
                        </p>

                        <p>
                            <strong>Duration:</strong> @item.Duration Days
                        </p>

                        <p>
                            <strong>Price:</strong> ₹@item.Price
                        </p>

                        <a asp-page="/Destination/Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-page="/Destination/Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    </div>

                </div>
            </div>
        }

    </div>

</div>