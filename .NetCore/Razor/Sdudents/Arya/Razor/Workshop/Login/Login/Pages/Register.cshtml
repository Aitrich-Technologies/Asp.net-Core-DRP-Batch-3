@page
@model Login.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center">
                    <h3>Create Your Account</h3>
                </div>

                <div class="card-body">
                    <form method="post">

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="row mb-3">
                            <div class="col">
                                <label asp-for="RegisterDto.FirstName" class="form-label"></label>
                                <input asp-for="RegisterDto.FirstName" class="form-control" />
                                <span asp-validation-for="RegisterDto.FirstName" class="text-danger"></span>
                            </div>

                            <div class="col">
                                <label asp-for="RegisterDto.LastName" class="form-label"></label>
                                <input asp-for="RegisterDto.LastName" class="form-control" />
                                <span asp-validation-for="RegisterDto.LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RegisterDto.Gender" class="form-label"></label>
                            <select asp-for="RegisterDto.Gender" class="form-select">
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                            <span asp-validation-for="RegisterDto.Gender" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RegisterDto.Dob" class="form-label"></label>
                            <input asp-for="RegisterDto.Dob" type="date" class="form-control" />
                            <span asp-validation-for="RegisterDto.Dob" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RegisterDto.UserName" class="form-label"></label>
                            <input asp-for="RegisterDto.UserName" class="form-control" />
                            <span asp-validation-for="RegisterDto.UserName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RegisterDto.Password" class="form-label"></label>
                            <input asp-for="RegisterDto.Password" type="password" class="form-control" />
                            <span asp-validation-for="RegisterDto.Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RegisterDto.EmailId" class="form-label"></label>
                            <input asp-for="RegisterDto.EmailId" class="form-control" />
                            <span asp-validation-for="RegisterDto.EmailId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RegisterDto.TelephoneNo" class="form-label"></label>
                            <input asp-for="RegisterDto.TelephoneNo" class="form-control" />
                            <span asp-validation-for="RegisterDto.TelephoneNo" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                Register
                            </button>
                        </div>

                    </form>
                </div>

                <div class="card-footer text-center">
                    Already have an account?
                    <a asp-page="/Login">Login</a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}