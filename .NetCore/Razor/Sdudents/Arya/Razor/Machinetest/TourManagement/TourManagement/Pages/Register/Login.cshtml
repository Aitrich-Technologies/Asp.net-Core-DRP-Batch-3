@page
@model TourManagement.Pages.Register.LoginModel
@{
}
<h2>Login</h2>
<form method="post">

    <input asp-for="Login.UserName" placeholder="Username" />
    <br /><br />

    <input asp-for="Login.Password" type="password" placeholder="Password" />
    <br /><br />

    <button type="submit">Login</button>

</form>

<p style="color:red">@Model.Message</p>