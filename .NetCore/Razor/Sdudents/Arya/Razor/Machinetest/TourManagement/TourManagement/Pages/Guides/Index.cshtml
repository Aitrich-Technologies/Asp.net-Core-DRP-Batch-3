@page
@model TourManagement.Pages.Guides.IndexModel
@{
}

<h2>Guide List</h2>

<p>
    <a asp-page="Create">Add Guide</a>
</p>

@foreach (var guide in Model.Guides)
{
    <div>
        <p><strong>Id:</strong> @guide.Id</p>
        <p><strong>Name:</strong> @guide.GuideName</p>
        <p><strong>Phone:</strong> @guide.PhoneNumber</p>
        <p><strong>Experience:</strong> @guide.Experience</p>
        <p><strong>Language:</strong> @guide.Langauage</p>

        <a asp-page="Edit" asp-route-id="@guide.Id">Edit</a>
        |
        <a asp-page="Delete" asp-route-id="@guide.Id">Delete</a>

        <hr />
    </div>
}

<a asp-page="/Logout">Logout</a>