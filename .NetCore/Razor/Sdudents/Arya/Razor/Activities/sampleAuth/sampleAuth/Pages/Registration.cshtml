@page
@model sampleAuth.Pages.RegistrationModel
@{
}
<h2>Register</h2>
<form method="post">

    <label>UserName:</label>
    <input type="text" asp-for="Newuser.UserName" required />
    <span asp-validation-for="Newuser.UserName" class=" text-danger"/>

    <label>Password:</label>
    <input type="text" asp-for="Newuser.password" required />
    <span asp-validation-for="Newuser.password" class=" text-danger" />

    <button type="submit">Register</button>
</form>
<p class="text-danger">@Html.ValidationSummary(true,"",new { @class = "text-danger" })</p>
    <a href="/Login">Already have an account? Login</a>