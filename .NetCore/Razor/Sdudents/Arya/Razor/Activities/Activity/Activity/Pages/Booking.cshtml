@page
@model Activity.Pages.BookingModel
@{
}
<h2>Booking Form</h2>

<form>

    Customer Name :
    <input type="text" />
    <br /><br />

    Email :
    <input type="email" />
    <br /><br />

    Mobile Number :
    <input type="text" />
    <br /><br />

    Package :

    <select>
        <option>Kerala Tour</option>
        <option>Goa Tour</option>
        <option>Maldives Tour</option>
    </select>

    <br /><br />

    Travel Date :
    <input type="date" />
    <br /><br />

    Number Of Persons :
    <input type="number" />
    <br /><br />

    Special Requests :
    <textarea></textarea>

    <br /><br />

    <input type="submit" value="Book Now" />

</form>