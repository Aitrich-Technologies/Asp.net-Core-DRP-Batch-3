@page
@model Activity.Pages.TourPackageModel
@{
}
<partial name="_message" />
<h2>TourPackage Form</h2>
<form>
    <label>PackageID </label>
    <input asp-for="PackageID" />
    <span asp-validation-for="PackageID"></span>
    <br /><br />

    <label>Package Name</label>
    <input asp-for="PackageName" />
    <span asp-validation-for="PackageName"></span>
    <br /><br />

    <label>Destination</label>
    <input asp-for="Destination" />
    <span asp-validation-for="Destination"></span>
    <br /><br />

    <label>Price</label>
    <input asp-for="Price" />
    <span asp-validation-for="Price"></span>
    <br /><br />

    <label>Duration</label>
    <input asp-for="Duration" />
    <span asp-validation-for="Duration"></span>
    <br /><br />

    <h4>Tour Type</h4>

    <input type="radio" name="TourType" /> Domestic
    <input type="radio" name="TourType" /> International

    <br /><br />

    <h4>Facilities</h4>

    <input type="checkbox" /> Food
    <input type="checkbox" /> Hotel
    <input type="checkbox" /> Guide

    <br /><br />

    <label>Description</label>
    <textarea></textarea>

    <br /><br />

    <label>Tour Image</label>
    <input type="file" />

    <br /><br />

    <input type="submit" value="Submit" />
    <input type="reset" value="Reset" />

</form>

