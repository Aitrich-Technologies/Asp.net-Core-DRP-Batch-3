@page
@model RazorMachineTest2.Pages.LoginModel
@{
}
<form method="post">
    <div class="mb-3">
        <label asp-for="LoginDto.UserName" class="form-label"></label>
        <input asp-for="LoginDto.UserName" class="form-control" placeholder="Username" />
        <span asp-validation-for="LoginDto.UserName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="LoginDto.Password" class="form-label"></label>
        <input asp-for="LoginDto.Password" class="form-control" type="password" placeholder="Password" />
        <span asp-validation-for="LoginDto.Password" class="text-danger"></span>
    </div>
    <div class="d-grid gap-2">
        <button type="submit" class="btn btn-success btn-block">Login</button>
    </div>
</form>
